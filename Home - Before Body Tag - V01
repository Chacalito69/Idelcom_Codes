<!-- Script JavaScript -->
<script>
// Selecciona todos los contenedores con la clase 'tabs-nav-item-underline'
document.querySelectorAll('.tabs-nav-item-underline').forEach(function(tab) {
  tab.addEventListener('click', function() {
    // Remueve la clase 'active' de todos los SVGs con la clase 'icono-logo'
    document.querySelectorAll('.icono-logo.active').forEach(function(activeIcon) {
      activeIcon.classList.remove('active');
    });

    // Busca el SVG dentro del contenedor clickeado
    const icon = this.querySelector('.icono-logo');
    if (icon) {
      // Agrega la clase 'active' al SVG encontrado
      icon.classList.add('active');
    }
  });
});
</script>
